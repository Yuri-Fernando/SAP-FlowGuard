# Provider: mock | sandbox | hybrid | live
SAP_MODE=mock
SAP_MOCK_BASE_URL=http://sap-mock:8080
SAP_SANDBOX_BASE_URL=https://sandbox.api.sap.com/s4hanacloud
SAP_API_KEY=
SAP_LIVE_BASE_URL=
SAP_READ_USERNAME=
SAP_READ_PASSWORD=
SAP_WRITE_USERNAME=
SAP_WRITE_PASSWORD=

# Safe by default: writes are refused unless every applicable flag is enabled.
ENABLE_SAP_WRITE=false
REQUIRE_HUMAN_APPROVAL=true
ALLOW_FI_POSTING=false
ALLOW_BILLING_CANCEL=false
ALLOW_INVOICE_RELEASE=false

DATABASE_URL=postgresql+psycopg://flowguard:flowguard@postgres:5432/flowguard
REDIS_URL=redis://redis:6379/0
DEMO_SCENARIO=billing_without_fi
FLOWGUARD_API_URL=http://flowguard-api:8000

N8N_ENCRYPTION_KEY=change-this-local-development-key
N8N_USER_MANAGEMENT_DISABLED=true
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
# Optional: create in n8n Settings > n8n API to show workflow/execution history.
N8N_API_KEY=

LLM_PROVIDER=disabled
LLM_API_KEY=
LOG_LEVEL=INFO

